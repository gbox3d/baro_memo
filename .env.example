# baro_memo backend — .env 로 복사해서 채운다. 재시작해야 반영된다.

# 듣는 포트/호스트. 포트 선정 근거는 system_info/readme.md 9.2 (비어 있는 번호를 고른다).
PORT=3000
HOST=0.0.0.0

# 관리자 토큰 — /api/admin/* 와 관리자 페이지가 쓴다. 비면 토큰 발급이 503 으로 막힌다
# (메모 읽기·쓰기는 계속 된다).
#
# 두 방법이 있고 **파일이 이긴다**. 파일을 가리켰는데 못 읽으면 미설정으로 간다 — 아래
# ADMIN_TOKEN 으로 몰래 내려가지 않는다. 그래야 "고친 파일과 서버가 읽은 값이 다르다"가 없다.
#
# 운영 호스트는 DB 옆에 둔다. 자격증명은 자기가 지키는 데이터와 같은 수명이어야 한다 —
# 저장소를 다시 받아도 보드와 열쇠가 함께 남는다. 파일 권한은 600 으로.
ADMIN_TOKEN_FILE=/mnt/data/baro_memo_db/admin-token
#ADMIN_TOKEN=

# DB 경로. 기본값은 <repo>/localfiles/memo.db 지만, 운영 호스트는 저장소 밖 볼륨을 쓴다 —
# 저장소를 지우거나 다시 받아도 보드가 살아 있어야 한다. 디렉터리는 없으면 만들어진다.
MEMO_DB=/mnt/data/baro_memo_db/memo.db

# 리버스 프록시 뒤에서 X-Forwarded-Prefix 를 못 붙일 때의 외부 URL 접두사 (nginx 스니펫은 헤더로 준다)
#BASE_PATH=/memo

# 팀원에게 **건네는** 주소 — 밖에서 닿는 주소다. 관리자 페이지의 초대 메시지가 이 값으로
# 주소를 만든다. 비워 두면 운영자가 그때 열어 본 주소로 떨어지는데, 사내망 IP 로 열어 두고
# 밖에 있는 팀원에게 그 주소를 보내면 그 사람은 영영 못 닿는다.
# baro_kalory 의 .env 와 같은 이름을 쓴다(같은 사실을 두 이름으로 부르지 않는다).
RELEASE_BASE_URL=http://gobackdev.iptime.org:22030

# 아티팩트 저장소(apps/files)의 바이트가 사는 곳. 이 프로세스가 보드와 함께 든다(0.11.0).
# 기본값은 <repo>/localfiles/files 지만, 운영 호스트는 DB 와 같은 외장 볼륨을 쓴다 —
# 수 GB 짜리 릴리스가 루트 디스크를 채우면 보드까지 같이 멎는다.
#
# **파일은 그냥 파일이다**: 여기에 store/<sha256> 과 tmp/<세션id> 가 평범한 파일로 앉고
# DB 에는 장부만 있다. deploy/nginx-baro-files.conf 의 alias 뿌리와 **같아야 한다** —
# 한쪽만 바꾸면 다운로드가 404 다. 이 경로를 못 열면 저장소만 503 이고 보드는 선다.
FILES_ROOT=/mnt/data/baro_memo_files
